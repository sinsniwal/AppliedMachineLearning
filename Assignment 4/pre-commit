#!/bin/bash
# Pre-commit hook to run tests before allowing a commit

echo "Running pre-commit hook: pytest"

# Navigate to the assignment 4 directory to run its specific tests
# (Assuming the hook is run from the root of the git repo)
cd temp/ass4 || { echo "Failed to find temp/ass4. Are you at the repo root?"; exit 1; }

# Run pytest on test.py
pytest test.py
TEST_RESULT=$?

if [ $TEST_RESULT -ne 0 ]; then
  echo "================================================="
  echo "Tests failed! Commit rejected."
  echo "Please fix the failing tests before committing."
  echo "================================================="
  exit 1
fi

echo "All tests passed. Proceeding with commit..."
exit 0
